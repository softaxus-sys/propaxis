# Copy to .env for local development.

DATABASE_URL="postgresql://propaxis:propaxis@localhost:5432/propaxis?schema=public"

# Auth.js
AUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# LLM provider for Qasro AI (tool-calling orchestrator).
# Any OpenAI-compatible chat-completions endpoint works — defaults to Groq (free tier).
# Get a free key at https://console.groq.com/keys
AI_API_KEY=""
AI_BASE_URL="https://api.groq.com/openai/v1"
AI_MODEL="llama-3.3-70b-versatile"
# To use OpenRouter instead: AI_BASE_URL="https://openrouter.ai/api/v1", pick a model
# from https://openrouter.ai/models (filter by "tools" support), e.g.
# AI_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# Object storage (S3-compatible) — for listing media. Using Contabo Object Storage
# (S3-compatible); any S3-compatible provider works the same way.
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Optional — only needed on Contabo, where public image URLs require this prefixed to
# the bucket name (see src/lib/storage.ts). Leave blank and it's derived automatically
# via GetBucketAcl; set it in production to skip that extra round-trip on every
# serverless cold start. Find it as the part before "$" in GetBucketAcl's Owner.ID, or
# in the working public URL Contabo's dashboard shows for an object in this bucket.
S3_TENANT_ID=""

# Redis (rate limiting, caching)
REDIS_URL="redis://localhost:6379"

# OpenSearch (full-text + facet search)
OPENSEARCH_URL="http://localhost:9200"

# VRODUX integration is per-agency, not global — each Agency connects its own VRODUX
# tenant from its agency dashboard settings. No env var needed here; see
# src/modules/vrodux-integration/client.ts and docs/ARCHITECTURE.md §7.

# Auto-provisions a VRODUX trial tenant when an agency is approved (see
# src/modules/vrodux-integration/tenant-provisioning.ts and docs/ARCHITECTURE.md §7.1).
# Leave blank to disable — approval still works, trial provisioning just fails silently
# (recorded on the Agency row/AuditLog) until VRODUX exposes this endpoint.
VRODUX_PROVISIONING_URL=""
VRODUX_PROVISIONING_API_KEY=""
VRODUX_TRIAL_DAYS="14"

# VRODUX↔Qasro OAuth: lets an agency that runs its business ON Vrodux connect that
# tenant to Qasro and have its published listings synced in. See
# docs/ARCHITECTURE.md §7.2 and src/modules/vrodux-integration/oauth*.ts.
# QASRO_VRODUX_CLIENT_SECRET: shared secret with the Vrodux team — generate with
#   `openssl rand -base64 32`, give it to them, never commit the real value.
# QASRO_VRODUX_REDIRECT_URI: the exact callback URL Vrodux gave you, e.g.
#   https://<their-domain>/api/real-estate/qasro-integration/oauth/callback — must
#   match byte-for-byte or the authorize/token flow refuses the request.
QASRO_VRODUX_CLIENT_SECRET=""
QASRO_VRODUX_REDIRECT_URI=""

# Vrodux's API host for pulling a connected agency's published listings (confirm the
# production value with the Vrodux/Softaxis team).
VRODUX_API_HOST="https://erp.vrodux.com"

# Authorizes the scheduled Vrodux listing-sync job (vercel.json cron, once daily —
# Vercel Hobby's cron limit, see that route's comment). Vercel sends this automatically
# as `Authorization: Bearer {CRON_SECRET}`. Leave blank in local dev to hit
# /api/cron/vrodux-sync unauthenticated.
CRON_SECRET=""

# Transactional email (src/lib/email.ts) — SMTP, so any provider works: Vrodux's own
# mail infra, SES, Postmark, SendGrid, Office365, Google Workspace, etc. Leave blank to
# disable — sendEmail() logs a warning and no-ops instead of throwing, so e.g. lead
# routing (src/modules/leads/actions.ts) still succeeds, it just won't email anyone.
EMAIL_SMTP_HOST=""
EMAIL_SMTP_PORT="587"
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASSWORD=""
# "From" address — noreply@vrodux.com for now per the team's instruction, swap to
# noreply@qasro.com once that domain has its own verified sending setup (SPF/DKIM) with
# whichever SMTP provider is configured above.
EMAIL_FROM="Qasro <noreply@vrodux.com>"
# Where enquiries land when there's no agent/agency to route to, and the default
# reply-to on outgoing emails.
CONTACT_EMAIL="hello@softaxis.ae"

# CAPTCHA (Cloudflare Turnstile) on registration and enquiry forms — see
# src/components/ui/turnstile.tsx and src/lib/turnstile.ts. Leave blank to disable
# (forms work without it, just unprotected) — get free keys at
# https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Upstash Redis (REST-based, serverless-friendly — see src/lib/rate-limit.ts) for
# rate limiting shared across Vercel's multiple instances. Leave blank to fall back to
# the previous in-memory limiter (works, just per-instance, not shared). Free tier at
# https://console.upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
